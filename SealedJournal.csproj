<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0-windows7.0</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationName>Sealed Journal</ApplicationName>
		<AssemblyName>notepad</AssemblyName>
		<RootNamespace>SealedJournal</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="appsettings.example.json">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="ABOUT.txt" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="SealedJournal.Tests\**\*.cs" />
	</ItemGroup>
</Project>